{
  "name": "recur",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Recurring payments and subscription billing infrastructure for Stellar",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "tsc -b --force && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "dev:api": "pnpm --filter @recur/api dev",
    "dev:scheduler": "pnpm --filter @recur/scheduler dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
