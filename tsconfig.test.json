{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@recur/core": ["packages/core/src/index.ts"],
      "@recur/ledger": ["packages/ledger/src/index.ts"],
      "@recur/stellar": ["packages/stellar/src/index.ts"],
      "@recur/scheduler": ["apps/scheduler/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "apps/*/src/**/*.ts", "vitest.config.ts"]
}
