# Copy to .env for local development. Never commit a real secret.

PORT=3000
HOST=0.0.0.0

# key:merchantId pairs, comma separated. Local development only.
RECUR_API_KEYS=sk_test_local:mrc_local

# Run the billing loop inside the API process (convenient locally).
RECUR_EMBEDDED_SCHEDULER=true
RECUR_TICK_INTERVAL_MS=60000

# Leave the three below unset to run against the in-memory mock executor:
# no network, no keys, no funded account needed.

# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Spender account the payer approves. Use a testnet key. In production this
# belongs in a KMS, not in an env var.
# STELLAR_SPENDER_SECRET=S...
# SEP-41 token contract that settles the plan asset (e.g. the SAC for USDC).
# RECUR_TOKEN_CONTRACT_ID=C...

LOG_LEVEL=info
